    {
      "name": "Enviar mensaje de contacto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nombre de prueba\",\n  \"subject\": \"Consulta\",\n  \"message\": \"Mensaje enviado desde Postman.\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/clubs/{{club_id}}/website/contact",
          "host": ["{{base_url}}"],
          "path": ["clubs", "{{club_id}}", "website", "contact"]
