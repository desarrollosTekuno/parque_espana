      "name": "Obtener carrusel",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/clubs/{{club_id}}/website/carousel",
          "host": ["{{base_url}}"],
          "path": ["clubs", "{{club_id}}", "website", "carousel"]
        },
        "description": "Devuelve las imágenes del carrusel con descripción e image_url."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Data es un arreglo', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
