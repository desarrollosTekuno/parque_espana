                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Obtener todos los eventos",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/clubs/{{club_id}}/website/events",
                    "host": ["{{base_url}}"],
                    "path": ["clubs", "{{club_id}}", "website", "events"]
                },
                "description": "Devuelve todos los eventos del parque."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Data es un arreglo', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Obtener eventos por mes",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/clubs/{{club_id}}/website/events?year={{year}}&month={{month}}",
                    "host": ["{{base_url}}"],
                    "path": ["clubs", "{{club_id}}", "website", "events"],
                    "query": [
                        { "key": "year", "value": "{{year}}" },
                        { "key": "month", "value": "{{month}}" }
                    ]
                },
                "description": "Devuelve únicamente los eventos del año y mes indicados."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Data es un arreglo', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Enviar mensaje de contacto",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Panfilo pancracio bonifancio de la paz\",\n  \"email\": \"persona@example.com\",\n  \"subject\": \"Es un asunto de prueba\",\n  \"message\": \"Mensaje enviado desde Postman. Muajajaja\"\n}",
                    "options": {
                        "raw": { "language": "json" }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/clubs/{{club_id}}/website/contact",
                    "host": ["{{base_url}}"],
                    "path": ["clubs", "{{club_id}}", "website", "contact"]
                },
                "description": "Guarda un mensaje enviado desde el formulario de contacto de la página web."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 201', () => pm.response.to.have.status(201));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Obtener datos de contacto y redes sociales",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{api_token}}" }
                ],
                "url": {
                    "raw": "{{base_url}}/clubs/{{club_id}}/contact-info",
                    "host": ["{{base_url}}"],
                    "path": ["clubs", "{{club_id}}", "contact-info"]
                },
                "description": "Devuelve datos de contacto y redes sociales del parque indicado. Requiere token Sanctum."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        }
    ]
}
